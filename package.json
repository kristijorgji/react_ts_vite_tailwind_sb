{
  "name": "react_ts_vite_tailwind_sb",
  "author": "https://github.com/kristijorgji",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "husky && node scripts/sync-agent-skills.mjs",
    "dev": "vite",
    "test": "vitest run --coverage",
    "test:ui": "vitest --ui --coverage",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "lint:eslint": "eslint . --max-warnings 0",
    "fix": "eslint . --fix --max-warnings 0",
    "dupcheck": "jscpd",
    "dupcheck:tests": "jscpd --config .jscpd.tests.json",
    "knip": "knip",
    "lint": "pnpm lint:eslint && pnpm dupcheck && pnpm knip",
    "analyze:test-mocks": "kj-analyze test-mocks",
    "preview": "vite preview",
    "gen:i18n": "i18next-resources-for-ts interface -i ./public/locales -o ./src/i18n/resources.d.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:preview": "serve storybook-static"
  },
  "dependencies": {
    "@kristijorgji/react-localized-routing": "^0.1.0",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^7.13.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@kristijorgji/code-analysis": "^0.1.2",
    "@kristijorgji/eslint-config-react-typescript": "^2.2.1",
    "@kristijorgji/eslint-plugin": "^0.2.0",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "@welldone-software/why-did-you-render": "^10.0.1",
    "c8": "^12.0.0",
    "clsx": "^2.1.1",
    "eslint": "^10.9.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-formatjs": "^6.5.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-dom": "^5.18.6",
    "eslint-plugin-react-x": "^5.18.6",
    "eslint-plugin-storybook": "^10.5.10",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "i18next-resources-for-ts": "^2.0.2",
    "jscpd": "^5.0.16",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-react-remove-attributes": "^1.0.3",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "eslint"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.15.4"
}
